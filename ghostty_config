# Ghostty configuration.
# Docs: https://ghostty.org/docs/config  (`ghostty +show-config --default --docs`)

# keybinds
keybind = global:ctrl+cmd+shift+alt+space=toggle_quick_terminal

# fonts
font-family = IoskeleyMono Nerd Font
font-size = 14

# theme
theme = light: Aizen Light, dark: Monokai Pro

# icon
macos-icon = blueprint
