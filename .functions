# Simple calculator function
calc() {
    [[ $# -eq 0 ]] && { printf 'Usage: calc <expression>\n' >&2; return 1; }

    local result
    result="$(printf '%s\n' "scale=10;$*" | bc --mathlib 2>&1)" || {
        printf 'calc error: %s\n' "$result" >&2
        return 1
    }

    result="$(printf '%s' "$result" | tr -d '\\\n')"

    if [[ "$result" == *.* ]]; then
        # add leading 0 for ".5" / "-.5", then strip trailing zeros and a bare dot
        printf '%s' "$result" |
        sed -e 's/^\./0./' -e 's/^-\./-0./' -e 's/0*$//;s/\.$//'
    else
        printf '%s' "$result"
    fi
    printf '\n'
}
alias calc='noglob calc'

# Brew do everything
function brewdo() {
    brew update && brew upgrade && brew cleanup -s
}

# Git add, commit, and push — with a guard against auto-pushing to main/master.
function gap() {
    if [[ $# -eq 0 ]]; then
        echo 'Usage: gap "commit message"' >&2
        return 1
    fi
    local branch
    branch="$(git symbolic-ref --short HEAD 2>/dev/null)" || {
        echo 'gap: not inside a git repository' >&2
        return 1
    }
    if [[ "$branch" == "main" || "$branch" == "master" ]]; then
        printf 'gap: refusing to auto-commit+push to "%s". Do it manually.\n' "$branch" >&2
        return 1
    fi
    # push.autoSetupRemote in ~/.gitconfig handles the first push of a new branch.
    git add -A && git commit -m "$1" && git push
}

# Adding a function to get IP for other bash scripts
myip() { curl -s ifconfig.me; }

# Safe remove — lists targets, then asks before deleting.
# Named `del` (not an `rm` override) so scripts and other machines keep the real rm.
# Uses zsh's `read "var?prompt"` form; bash-style `read -p` does not prompt in zsh.
del() {
    [[ $# -eq 0 ]] && { printf 'Usage: del <file>...\n' >&2; return 1; }
    ls -FCsd -- "$@"
    local ans
    read "ans?Delete? [y/N] "
    [[ "$ans" == [yY] ]] && /bin/rm -- "$@"
}

# Make a directory (and parents) then cd into it.
mkcd() {
    [[ $# -eq 1 ]] || { printf 'Usage: mkcd <dir>\n' >&2; return 1; }
    mkdir -p -- "$1" && cd -- "$1"
}

# Clone a repo and cd into it. Accepts a full URL or GitHub "owner/repo" shorthand.
gclone() {
    [[ $# -eq 1 ]] || { printf 'Usage: gclone <url|owner/repo>\n' >&2; return 1; }
    local url="$1"
    [[ "$url" != *://* && "$url" != git@* ]] && url="https://github.com/$url.git"
    git clone "$url" && cd -- "$(basename "${url%.git}")"
}

# sandcastle: mosh in + attach session (abduco: zero terminal emulation,
# everything behaves native; detach with Ctrl+\).
# --no-init: mosh otherwise puts the outer terminal in ALTERNATE SCREEN mode,
# where Ghostty deliberately converts wheel scrolls to Up/Down arrows
# (mosh#774, ghostty#7630) — that's the history-cycling. --no-init keeps the
# primary screen so the wheel scrolls the viewport natively. Caveat from mosh
# docs: scrollback can occasionally miss redrawn lines; tmux stays the
# perfect-scrollback option. Verified flag exists (mosh --help), 2026-09-05.
# Session sharing: bare `sand` attaches session "dev" — run it in two windows
# and they mirror each other (shared input!). Pass a name for a private one.
# Default (no arg) spawns the next free devN (dev1, dev2, …): one ssh
# round-trip lists sessions, purges terminated ones, picks the lowest free
# number. The session name always prints before mosh takes the screen.
#
# Connection details live in an untracked per-machine file (~/.config/sandcastle.env)
# so this public repo never names the host or user:
#   SANDCASTLE_HOST="user@host"
#   SANDCASTLE_ABUCO="/home/<user>/.local/bin/abduco"
sand() {
    local env_file="$HOME/.config/sandcastle.env"
    [[ -f "$env_file" ]] && source "$env_file"
    if [[ -z "${SANDCASTLE_HOST:-}" || -z "${SANDCASTLE_ABUCO:-}" ]]; then
        printf 'sand: set SANDCASTLE_HOST and SANDCASTLE_ABUCO in %s\n' "$env_file" >&2
        return 1
    fi
    local host="$SANDCASTLE_HOST" abduco="$SANDCASTLE_ABUCO"
    local name="${1:-}"
    if [[ -z "$name" ]]; then
        local existing
        existing=$(ssh -o ConnectTimeout=10 "$host" \
            "$abduco | awk '/^\+/ {print \$(NF-1), \$NF}' | while read -r pid nm; do case \$pid in ''|*[!0-9]*) continue;; esac; kill \"\$pid\" 2>/dev/null; rm -f \"\$HOME/.abduco/\${nm}@*\"; done; $abduco" 2>/dev/null) \
            || { echo "sand: cannot reach $host"; return 1; }
        local n=1
        while printf '%s\n' "$existing" | grep -qE "(^|[^0-9A-Za-z_])dev${n}([@]|$)"; do
            n=$((n + 1))
        done
        name="dev$n"
    fi
    printf '\n=== sandcastle session: %s ===\n\n' "$name"
    mosh --no-init "$host" -- "$abduco" -A "$name" /usr/bin/zsh
}

# Extract just about any archive without remembering the flags.
extract() {
    [[ -f "$1" ]] || { printf 'extract: "%s" is not a file\n' "$1" >&2; return 1; }
    case "$1" in
        *.tar.bz2|*.tbz2) tar xjf "$1"   ;;
        *.tar.gz|*.tgz)   tar xzf "$1"   ;;
        *.tar.xz|*.txz)   tar xJf "$1"   ;;
        *.tar)            tar xf  "$1"   ;;
        *.gz)             gunzip  "$1"   ;;
        *.bz2)            bunzip2 "$1"   ;;
        *.zip)            unzip   "$1"   ;;
        *.rar)            unrar x "$1"   ;;
        *.7z)             7z x    "$1"   ;;
        *.Z)              uncompress "$1" ;;
        *) printf 'extract: unknown archive type: %s\n' "$1" >&2; return 1 ;;
    esac
}

