# Simple calculator function
calc() {
    [[ $# -eq 0 ]] && { printf 'Usage: calc <expression>\n' >&2; return 1; }

    local result
    result="$(printf '%s\n' "scale=10;$*" | bc --mathlib 2>&1)" || {
        printf 'calc error: %s\n' "$result" >&2
        return 1
    }

    result="$(printf '%s' "$result" | tr -d '\\\n')"

    if [[ "$result" == *.* ]]; then
        printf '%s' "$result" |
        sed -e 's/^\./0./'        `# add "0" for cases like ".5"`  \
            -e 's/^-\./-0./'      `# add "0" for cases like "-.5"` \
            -e 's/0*$//;s/\.$//'   # remove trailing zeros
    else
        printf '%s' "$result"
    fi
    printf '\n'
}
alias calc='noglob calc'

# Brew do everything
function brewdo() {
    brew update && brew upgrade && brew cleanup -s
}

# Git add, commit, and push — with a guard against auto-pushing to main/master.
function gap() {
    if [[ $# -eq 0 ]]; then
        echo 'Usage: gap "commit message"' >&2
        return 1
    fi
    local branch
    branch="$(git symbolic-ref --short HEAD 2>/dev/null)" || {
        echo 'gap: not inside a git repository' >&2
        return 1
    }
    if [[ "$branch" == "main" || "$branch" == "master" ]]; then
        printf 'gap: refusing to auto-commit+push to "%s". Do it manually.\n' "$branch" >&2
        return 1
    fi
    # push.autoSetupRemote in ~/.gitconfig handles the first push of a new branch.
    git add -A && git commit -m "$1" && git push
}

# Adding a function to get IP for other bash scripts
myip() { curl -s ifconfig.me; }

# Safe remove — lists targets, then asks before deleting.
# Named `del` (not an `rm` override) so scripts and other machines keep the real rm.
# Uses zsh's `read "var?prompt"` form; bash-style `read -p` does not prompt in zsh.
del() {
    [[ $# -eq 0 ]] && { printf 'Usage: del <file>...\n' >&2; return 1; }
    ls -FCsd -- "$@"
    local ans
    read "ans?Delete? [y/N] "
    [[ "$ans" == [yY] ]] && /bin/rm -- "$@"
}

