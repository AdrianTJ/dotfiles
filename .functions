# Simple calculator
calc() {
    local result=""
    result="$(printf '%s\n' "scale=10;$*" | bc --mathlib | tr -d '\\\n')"

    if [[ "$result" == *.* ]]; then
        printf '%s' "$result" |
        sed -e 's/^\./0./'        \
            -e 's/^-\./-0./'      \
            -e 's/0*$//;s/\.$//'
    else
        printf '%s' "$result"
    fi
    printf '\n'
}

# Brew do everything 
function brewdo() {
		brew update && brew upgrade && brew cleanup -s
}